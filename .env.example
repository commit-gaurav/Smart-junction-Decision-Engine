# Server Settings
APP_ENV=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (SQLite local database file)
DATABASE_URL=sqlite:///./backend/data/junction.db

# Approved Software-Demo Timing Defaults (in seconds)
# IMPORTANT: These are editable demo simulation parameters, NOT road-engineering guidance.
MIN_GREEN_SECONDS=8
MAX_GREEN_SECONDS=45
YELLOW_SECONDS=3
ALL_RED_SECONDS=1
FAIRNESS_MAX_WAIT_SECONDS=90
PLANNING_TICK_SECONDS=1
STALE_THRESHOLD_SECONDS=30

# Optional Model Configuration (pre-trained YOLO video vehicle counting)
# If left empty, manual and seeded simulation inputs function completely independently.
YOLO_MODEL_PATH=
YOLO_CONFIDENCE_THRESHOLD=0.25

